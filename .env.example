# CyberCodeMini Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# Hugging Face
HF_TOKEN=
HF_HOME=

# Azure ML (only needed for cloud training)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE=
AZURE_COMPUTE_NAME=

# Optional: W&B for experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=cybercodemini

# Project
CYBERCODEMINI_ENV=development
CYBERCODEMINI_LOG_LEVEL=INFO
